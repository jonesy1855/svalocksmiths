 }
+
+/* ------------------------------------------------------------------ */
+/* Floating call / WhatsApp actions + trust strip                      */
+/* ------------------------------------------------------------------ */
+.floating-cta {
+    position: fixed;
+    right: 14px;
+    bottom: 14px;
+    z-index: 9999;
+    display: flex;
+    flex-direction: column;
+    align-items: flex-end;
+    gap: 10px;
+}
+.floating-cta a {
+    display: inline-flex;
+    align-items: center;
+    gap: 8px;
+    padding: 12px 18px;
+    border-radius: 999px;
+    font-weight: 700;
+    font-size: 0.9rem;
+    text-decoration: none;
+    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.45);
+    transition: transform 0.15s ease;
+}
+.floating-cta a:hover { transform: translateY(-2px); }
+.floating-cta .fc-call { background: #2ecc71; color: #000; }
+.floating-cta .fc-wa { background: #25d366; color: #0b141a; }
+@media (min-width: 768px) {
+    .floating-cta { flex-direction: row; align-items: center; }
+}
+
+.trust-strip {
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: center;
+    gap: 10px 28px;
+    padding: 18px 20px;
+    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
+    background: rgba(255, 255, 255, 0.02);
+}
+.trust-item {
+    display: inline-flex;
+    align-items: center;
+    gap: 8px;
+    color: #9ca3af;
+    font-size: 0.85rem;
+    font-weight: 600;
+    letter-spacing: 0.3px;
+}
+.trust-item strong { color: #e2e8f0; }
