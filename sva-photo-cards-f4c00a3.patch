Subject: [PATCH] Photo-led service cards on preview homepage

---
 assets/css/styles.css | 125 ++++++++++++++++++++++++++++++++++++++++++
 preview.html          |  58 +++++++++++++++-----
 2 files changed, 170 insertions(+), 13 deletions(-)

diff --git a/assets/css/styles.css b/assets/css/styles.css
index eff11d9..e74f122 100644
--- a/assets/css/styles.css
+++ b/assets/css/styles.css
@@ -2482,3 +2482,128 @@ body.preview-page .dropdown-content a:hover {
     background-color: rgba(46, 204, 113, 0.1);
     color: #2ecc71 !important;
 }
+
+/* --- SERVICE CARDS: PHOTO-LED --- */
+body.preview-page .services-grid {
+    gap: 1.5rem;
+}
+
+body.preview-page .service-card {
+    background-color: var(--secondary-bg);
+    border: 1px solid var(--border-color);
+    border-radius: 14px;
+    overflow: hidden;
+    display: flex;
+    flex-direction: column;
+    padding: 0;
+    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.25s ease, border-color 0.25s ease;
+}
+
+body.preview-page .service-card-link {
+    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
+}
+
+body.preview-page .service-card-link:hover {
+    transform: translateY(-6px);
+}
+
+body.preview-page .service-card-link:hover .service-card {
+    border-color: color-mix(in srgb, var(--svc-accent, #2ecc71) 70%, transparent);
+    box-shadow: 0 12px 28px -10px rgba(0, 0, 0, 0.7), 0 14px 30px -10px color-mix(in srgb, var(--svc-accent, #2ecc71) 40%, transparent);
+}
+
+body.preview-page .service-card-photo {
+    position: relative;
+    height: 150px;
+    background-color: #000;
+    overflow: hidden;
+}
+
+body.preview-page .service-card-photo img {
+    width: 100%;
+    height: 100%;
+    object-fit: cover;
+    display: block;
+    transition: transform 0.45s ease;
+}
+
+body.preview-page .service-card-link:hover .service-card-photo img {
+    transform: scale(1.06);
+}
+
+body.preview-page .service-card-photo::after {
+    content: "";
+    position: absolute;
+    inset: 0;
+    background: linear-gradient(180deg, rgba(0, 0, 0, 0.1) 0%, rgba(0, 0, 0, 0.6) 100%);
+    pointer-events: none;
+}
+
+body.preview-page .service-card-icon {
+    position: absolute;
+    left: 14px;
+    bottom: 12px;
+    z-index: 1;
+    width: 44px;
+    height: 44px;
+    border-radius: 10px;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    color: var(--svc-accent, #2ecc71);
+    background: rgba(0, 0, 0, 0.55);
+    border: 1px solid color-mix(in srgb, var(--svc-accent, #2ecc71) 60%, transparent);
+    backdrop-filter: blur(3px);
+}
+
+body.preview-page .service-card-icon svg {
+    width: 23px;
+    height: 23px;
+}
+
+body.preview-page .service-card-body {
+    padding: 1.4rem 1.4rem 1.6rem;
+    display: flex;
+    flex-direction: column;
+    flex: 1 1 auto;
+}
+
+body.preview-page .service-card h3 {
+    color: var(--text-light);
+    text-transform: none;
+    font-size: 1.15rem;
+    line-height: 1.3;
+    margin: 0 0 0.5rem;
+}
+
+body.preview-page .service-card p {
+    color: var(--text-muted);
+    line-height: 1.6;
+    margin: 0;
+    flex: 1 1 auto;
+}
+
+body.preview-page .read-more {
+    display: inline-flex;
+    align-items: center;
+    margin-top: 1.1rem;
+    padding: 0.72rem 1.05rem;
+    border-radius: 999px;
+    background-color: var(--svc-accent, #2ecc71);
+    color: #fff;
+    font-weight: 600;
+    font-size: 0.82rem;
+    line-height: 1.2;
+    transition: transform 0.2s ease, filter 0.2s ease;
+}
+
+body.preview-page .service-card-link:hover .read-more {
+    color: #fff;
+    transform: translateY(-1px);
+    filter: brightness(1.12);
+}
+
+body.preview-page .emergency-lockout-card { --svc-accent: #2ecc71; }
+body.preview-page .spare-keys-card { --svc-accent: #1abc9c; }
+body.preview-page .all-keys-lost-card { --svc-accent: #e67e22; }
+body.preview-page .ac-regas-card { --svc-accent: #3498db; }
